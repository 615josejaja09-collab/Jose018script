-- Función para crear ESP rojo
local function createRedESP(character, player)
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    
    -- Crear highlight rojo
    local highlight = Instance.new("Highlight")
    highlight.Name = "Jose018ESP"
    highlight.FillColor = ESP_CONFIG.BOX_COLOR
    highlight.FillTransparency = ESP_CONFIG.BOX_TRANSPARENCY
    highlight.OutlineColor = ESP_CONFIG.BOX_COLOR
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character
    
    -- Billboard para nombre y info
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESPInfo"
    billboard.Size = UDim2.new(0, 200, 0, 80)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = hrp
    billboard.Parent = hrp
    
    -- Fondo del texto
    local background = Instance.new("Frame")
    background.Size = UDim2.new(1, 0, 1, 0)
    background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    background.BackgroundTransparency = 0.4
