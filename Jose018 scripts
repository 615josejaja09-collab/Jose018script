-- =================================================================
local platform, connection
local floorActive = false
local isRising = false
local RISE_SPEED = 15

local function destroyPlatform()
    if platform then 
        platform:Destroy() 
        platform = nil 
    end
    floorActive = false 
    isRising = false
    if connection then 
        connection:Disconnect() 
        connection = nil 
    end
    thirdFloorBtn.BackgroundColor3 = COLOR_SCHEME.WARNING
    thirdFloorStroke.Color = COLOR_SCHEME.ACCENT
    thirdFloorText.Text = "3RD FLOOR"
    thirdFloorIcon.Text = "🏗️"
end

local function canRise()
    if not platform then return false end
    local origin = platform.Position + Vector3.new(0, platform.Size.Y/2, 0)
    local direction = Vector3.new(0, 2, 0)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {platform, LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    return not workspace:Raycast(origin, direction, rayParams)
end

local function setup3rdFloor(character)
    local root = character:WaitForChild("HumanoidRootPart")
    
    thirdFloorBtn.MouseButton1Click:Connect(function()
        floorActive = not floorActive
        if floorActive then
            platform = Instance.new("Part")
            platform.Size = Vector3.new(6, 0.5, 6)
            platform.Anchored = true
            platform.CanCollide = true
            platform.Transparency = 0
            platform.Material = Enum.Material.Neon
            platform.Color = Color3.fromRGB(255, 200, 0)
            platform.Position = root.Position - Vector3.new(0, root.Size.Y/2 + platform.Size.Y/2, 0)
            platform.Parent = workspace

            -- Aplicar transparencia a Base Plots
            local plots = workspace:FindFirstChild("Plots")
            if plots then
                for _, plot in pairs(plots:GetChildren()) do
                    for _, part in pairs(plot:GetDescendants()) do
                        if part:IsA("BasePart") and (part.Name:lower():find("base plot") or part.Name:lower():find("base") or part.Name:lower():find("plot")) then
                            part.Transparency = 0.5
                        end
                    end
                end
            end

            isRising = true
            connection = RunService.Heartbeat:Connect(function(dt)
                if platform and floorActive then
                    local cur = platform.Position
                    local newXZ = Vector3.new(root.Position.X, cur.Y, root.Position.Z)
                    if isRising and canRise() then
                        platform.Position = newXZ + Vector3.new(0, dt * RISE_SPEED, 0)
                    else
                        isRising = false
                        platform.Position = newXZ
                    end
                end
            end)
            thirdFloorBtn.BackgroundColor3 = COLOR_SCHEME.SUCCESS
            thirdFloorStroke.Color = COLOR_SCHEME.SUCCESS
            thirdFloorText.Text = "🏗️ 3RD FLOOR ON"
            thirdFloorIcon.Text = "✅"
        else
            destroyPlatform()
        end
    end)
    
    character:WaitForChild("Humanoid").Died:Connect(destroyPlatform)
end

if LocalPlayer.Character then 
    setup3rdFloor(LocalPlayer.Character) 
end
LocalPlayer.CharacterAdded:Connect(setup3rdFloor)

