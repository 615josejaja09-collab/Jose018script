    local innerStroke = Instance.new("UIStroke")
    innerStroke.Color = COLOR_SCHEME.TEXT
    innerStroke.Thickness = 1
    innerStroke.Transparency = 0.9
    innerStroke.Parent = innerGlow
    
    -- Efectos de animación
    local hoverTween = TweenService:Create(button, TweenInfo.new(0.3), {
        BackgroundTransparency = 0.1,
        Size = UDim2.new(1, 5, 1, 5)
    })
    
    local leaveTween = TweenService:Create(button, TweenInfo.new(0.3), {
        BackgroundTransparency = 0,
        Size = UDim2.new(1, 0, 1, 0)
    })
    
    local clickTweenIn = TweenService:Create(button, TweenInfo.new(0.1), {
        BackgroundTransparency = 0.3,
        Position = UDim2.new(0, 2, 0, 2)
    })
    
    local clickTweenOut = TweenService:Create(button, TweenInfo.new(0.1), {
        BackgroundTransparency = 0.1,
        Position = UDim2.new(0, 0, 0, 0)
    })
    
    -- Efecto hover mejorado
    button.MouseEnter:Connect(function()
        hoverTween:Play()
        TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = 0.2}):Play()
        TweenService:Create(innerStroke, TweenInfo.new(0.3), {Transparency = 0.7}):Play()
    end)
    
    button.MouseLeave:Connect(function()
        leaveTween:Play()
        TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = 0.5}):Play()
