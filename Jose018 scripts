        clickTweenOut:Play()
    end)
    
    button.Parent = buttonContainer
    
    return buttonContainer, button, stroke, textLabel, iconLabel
end

-- Función para crear pestañas con scroll
local function createTab(tabName, displayName, icon)
    local tabButton = Instance.new("TextButton")
    tabButton.Size = UDim2.new(0, 90, 1, 0)
    tabButton.Text = icon .. "\n" .. displayName
    tabButton.Font = Enum.Font.GothamBold
    tabButton.TextSize = 12
    tabButton.TextColor3 = COLOR_SCHEME.TEXT
    tabButton.BackgroundColor3 = COLOR_SCHEME.SECONDARY
    tabButton.BackgroundTransparency = 0.4
    tabButton.AutoButtonColor = false
    tabButton.ZIndex = 9
    tabButton.Parent = tabFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = tabButton
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = COLOR_SCHEME.ACCENT
    stroke.Thickness = 2
    stroke.Transparency = 0.6
    stroke.Parent = tabButton
    
    local tabGradient = Instance.new("UIGradient")
    tabGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, COLOR_SCHEME.SECONDARY),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 50, 70))
    })
    tabGradient.Parent = tabButton
    
    -- Contenido de la pestaña (SCROLL FRAME)
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.BorderSizePixel = 0
    scrollFrame.ScrollBarThickness = 6
    scrollFrame.ScrollBarImageColor3 = COLOR_SCHEME.ACCENT
    scrollFrame.Visible = false
    scrollFrame.ZIndex = 6
    scrollFrame.Parent = mainContentFrame
    
    -- Layout para los botones
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 10)
    tabLayout.FillDirection = Enum.FillDirection.Vertical
    tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = scrollFrame
    
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 5)
    padding.PaddingLeft = UDim.new(0, 5)
    padding.PaddingRight = UDim.new(0, 5)
    padding.Parent = scrollFrame
    
    -- Actualizar tamaño del scroll frame
    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, tabLayout.AbsoluteContentSize.Y + 10)
    end)
    
    tabs[tabName] = scrollFrame
    tabButtons[tabName] = {Button = tabButton, Stroke = stroke}
    
    -- Evento de clic en la pestaña
    tabButton.MouseButton1Click:Connect(function()
        -- Ocultar todas las pestañas
        for name, content in pairs(tabs) do
            content.Visible = false
            tabButtons[name].Button.BackgroundColor3 = COLOR_SCHEME.SECONDARY
            tabButtons[name].Button.BackgroundTransparency = 0.4
            TweenService:Create(tabButtons[name].Stroke, TweenInfo.new(0.3), {Transparency = 0.6}):Play()
        end
        
        -- Mostrar pestaña seleccionada
        scrollFrame.Visible = true
        tabButton.BackgroundColor3 = COLOR_SCHEME.ACCENT
        tabButton.BackgroundTransparency = 0.2
        TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = 0.2}):Play()
        
        currentTab = tabName
    end)
    
    return scrollFrame
end

